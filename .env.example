# Copy to .env and fill in. Never commit .env.

# --- PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox -> your app)
# Leave empty to run with the built-in fake PayPal (demo mode).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook id from the app's Webhooks section (needs a public URL, e.g. a tunnel, pointing at /webhooks/paypal)
PAYPAL_WEBHOOK_ID=
# Send captured money on to the recipient with Payouts. Set false if Payouts is not enabled on your sandbox account.
PAYPAL_USE_PAYOUTS=true
# Sandbox *personal* account email that receives demo payouts (developer.paypal.com -> Sandbox accounts)
PAUSELINE_DEMO_RECIPIENT_EMAIL=
PAUSELINE_CURRENCY=USD

# --- AI, all free. Always on: rules + phrase lexicon + our on-device ML classifier.
# LLM layer: Groq free tier (console.groq.com -> API Keys). Leave empty to run ML + rules only.
GROQ_API_KEY=
# auto | groq | ollama | none
PAUSELINE_LLM_PROVIDER=auto
# Empty = default: openai/gpt-oss-120b on Groq (alternatives: openai/gpt-oss-20b, qwen/qwen3.8-27b); gpt-oss:20b on Ollama
PAUSELINE_LLM_MODEL=
# Public-site protection: payment checks per visitor per minute
PAUSELINE_ASSESS_PER_MINUTE=8

# --- Policy
# Cooling-off before a medium-risk payment is released automatically (seconds). Use 120 for demos.
PAUSELINE_COOLING_OFF_SECONDS=86400
